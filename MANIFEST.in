include pixel-eub
include LICENSE NOTICE.md README.md README.ru.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include docs *.md
recursive-include tests *.py
prune .venv
prune venv
prune .agents
prune .codex
prune .aws
prune .cache
prune cache
prune firmware
prune backups
prune logs
global-exclude __pycache__ *.py[cod] *.img *.zip *.bin *.dump *.elf *.hex *.log *.pem *.key .env .env.*
